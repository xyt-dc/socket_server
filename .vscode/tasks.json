{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build bench_server",
            "type": "shell",
            "command": "cmake --build build --target bench_server -j",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build all",
            "type": "shell",
            "command": "cmake --build build -j",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "test: epoll 全流程",
            "type": "shell",
            "command": "./test/test_04_epoll.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "test: 阶段1 客户端(smoke 1连接)",
            "type": "shell",
            "command": "python3 test/bench_client.py --port=6401 --mode=smoke --conns=1 --msgs=1",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "test: 阶段3 客户端(50连接压fd回收)",
            "type": "shell",
            "command": "python3 test/bench_client.py --port=6402 --mode=smoke --conns=50 --msgs=3",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        // ====================================================================
        //  ⑥ 调试配置专用的预构建任务
        //
        //  ★ 为什么不用 "CMake: build"：
        //    那是 CMake Tools 插件【内置】的任务名，只有当工作区已经
        //    Configure 过、且插件的 task provider 激活时才会出现。
        //    没 Configure 时 F5 就报「找不到任务 CMake: build」。
        //    自己定义一个明确名字，不依赖插件状态，永远可用。
        //
        //  ★ 为什么是全量 build 而不是只 build 当前 target：
        //    tasks.json 里拿不到「当前选中的 CMake target」这个变量。
        //    cmake --build 是增量构建，没改动的文件不会重编，
        //    实测 5 个单测全量也只要 1~2 秒。
        // ====================================================================
        {
            "label": "build 所有 target（调试前预构建）",
            "type": "shell",
            "command": "cmake --build build -j",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}