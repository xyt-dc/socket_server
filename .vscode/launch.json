{
    // ========================================================================
    //  VS Code 调试配置 —— 用于 test_04_epoll.sh 的单个阶段调试
    //
    //  【重要】test_04_epoll.sh 会自己启动服务端，端口会冲突。
    //   所以：
    //     · 想跑【整个脚本】→ 用命令行，不要在 IDE 里按 F5
    //     · 想【单步调试某阶段】→ 在 IDE 里 F5 启动服务端，
    //       然后另开终端手动跑对应的 bench_client.py 命令
    //
    //  F5 之后的操作顺序：
    //    1. 在 Epoll_server.hpp 里点行号左边打红点（断点）
    //    2. 打开一个终端，跑客户端去连它：
    //         python3 test/bench_client.py --port=6401 --mode=smoke --conns=1 --msgs=1
    //    3. 断点命中，就可以单步 / 看变量了
    // ========================================================================
    "version": "0.2.0",
    "configurations": [
        {
            "name": "① epoll 服务端 (6401) — 阶段1 单连接",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bench_server",
            "args": ["--server=epoll", "--port=6401"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "开启 GDB 美化输出（STL 容器可读）",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build bench_server"
        },
        {
            "name": "② epoll 服务端 (6402) — 阶段2 并发50",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bench_server",
            "args": ["--server=epoll", "--port=6402"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "开启 GDB 美化输出",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build bench_server"
        },
        {
            "name": "③ thread 服务端 (6412) — 对照组",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bench_server",
            "args": ["--server=thread", "--port=6412"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "开启 GDB 美化输出",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build bench_server"
        },
        {
            "name": "④ pool 服务端 (6413) — 对照组",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bench_server",
            "args": ["--server=pool", "--port=6413", "--workers=4"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "开启 GDB 美化输出",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build bench_server"
        },
        {
            // 适用于：已经用命令行/脚本起了一个 bench_server，
            // 想临时附加进去看现场。F5 后会弹出进程列表让你选。
            "name": "⑤ 附加到已运行的 bench_server",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/bench_server",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "开启 GDB 美化输出",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}